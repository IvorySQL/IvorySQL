SELECT v::binary_double
FROM (VALUES ('-Infinity'), ('-1'), ('0'), ('1'), ('Infinity'), ('NaN')) AS t(v),
     generate_series(1, 200);
SET enable_indexscan = off;
SET enable_bitmapscan = off;
SET enable_seqscan = on;
