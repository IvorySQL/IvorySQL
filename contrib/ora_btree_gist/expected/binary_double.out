-- binary_double check
CREATE TABLE binary_doubletmp (a binary_double);
\copy binary_doubletmp from 'data/binary_double.data'
SET enable_seqscan=on;
SELECT count(*) FROM binary_doubletmp WHERE a <  -1890.0;
 count 
-------
   237
(1 row)

SELECT count(*) FROM binary_doubletmp WHERE a <= -1890.0;
