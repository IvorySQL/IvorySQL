(1 row)

SELECT a, a <-> '-1890.0' FROM binary_doubletmp ORDER BY a <-> '-1890.0' LIMIT 3;
            a             |        ?column?         
--------------------------+-------------------------
 -1.89E+003               | 0
 -2.0036345120000001E+003 | 1.1363451200000009E+002
