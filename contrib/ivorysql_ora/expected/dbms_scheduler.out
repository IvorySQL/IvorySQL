			job_name)"
PL/iSQL function sys.dbms_scheduler.purge_log line 170 at PERFORM
SQL statement "CALL dbms_scheduler.purge_log(which_log => 'JOB_HISTORY')"
PL/iSQL function inline_code_block line 2 at CALL
-- Oracle takes a comma-separated list of job and job class names here; one
-- name at a time is supported, and the list has to be refused rather than
-- parsed as a single odd name that matches nothing
BEGIN
  dbms_scheduler.purge_log(job_name => 'purge_old,purge_new');
END;
/
ERROR:  purging the log of a list of jobs is not supported
HINT:  Call PURGE_LOG once per job, or leave job_name out to purge every job's log.
