 regress_dbms_scheduler | PURGE_LIVE | r      |     1
 regress_dbms_scheduler | PURGE_NEW  | s      |     1
 regress_dbms_scheduler | PURGE_OLD  | f      |     1
 sched_regress_u1       | U1_LOG     | s      |     1
 sched_regress_u2       | U2_LOG     | s      |     1
(5 rows)

-- a plain user cannot reach another user's history by naming it ...
SET SESSION AUTHORIZATION sched_regress_u1;
BEGIN
  dbms_scheduler.purge_log(job_name => 'regress_dbms_scheduler.purge_new');
END;
/
