--
-- quoted identifiers keep their case; unquoted ones are upper-cased
--
BEGIN
  dbms_scheduler.create_job(job_name => '"lower_job"', job_type => 'PLSQL_BLOCK',
      job_action => 'BEGIN NULL; END;');
END;
/
