--
-- ora_bit_and_agg.sql: test Oracle-compatible BIT_AND_AGG aggregate function
--
-- This test file uses Oracle syntax as much as possible,
-- so the same SQL can be run on an Oracle database for verification.
--
-- Oracle references:
--   https://docs.oracle.com/en/database/oracle/oracle-database/23/sqlrf/BIT_AND_AGG.html
--
--
-- Basic usage
--
SELECT bit_and_agg(bits)
FROM (SELECT 3 bits FROM dual
      UNION ALL SELECT 5 FROM dual);
 bit_and_agg 
-------------
           1
(1 row)

SELECT bit_and_agg(x) FROM (SELECT 12 x FROM dual
                            UNION ALL SELECT 10 FROM dual
                            UNION ALL SELECT 4 FROM dual) t;
 bit_and_agg 
-------------
           0
(1 row)

--
-- GROUP BY usage
--
CREATE TABLE bit_and_agg_test (grp text, val bigint);
INSERT INTO bit_and_agg_test VALUES ('a', 12);
INSERT INTO bit_and_agg_test VALUES ('a', 10);
INSERT INTO bit_and_agg_test VALUES ('a', 6);
INSERT INTO bit_and_agg_test VALUES ('b', 7);
INSERT INTO bit_and_agg_test VALUES ('b', 5);
SELECT grp, bit_and_agg(val) FROM bit_and_agg_test GROUP BY grp ORDER BY grp;
 grp | bit_and_agg 
-----+-------------
 a   |           0
 b   |           5
(2 rows)

--
-- NULL handling: NULLs are ignored
--
INSERT INTO bit_and_agg_test VALUES ('a', NULL);
SELECT grp, bit_and_agg(val) FROM bit_and_agg_test GROUP BY grp ORDER BY grp;
 grp | bit_and_agg 
-----+-------------
 a   |           0
 b   |           5
(2 rows)

-- All-NULL group returns NULL
CREATE TABLE bit_and_agg_nulls (grp text, val bigint);
INSERT INTO bit_and_agg_nulls VALUES ('a', NULL);
INSERT INTO bit_and_agg_nulls VALUES ('a', NULL);
SELECT bit_and_agg(val) IS NULL FROM bit_and_agg_nulls;
 ?column? 
----------
 t
(1 row)

-- Empty set returns NULL
SELECT bit_and_agg(val) IS NULL FROM bit_and_agg_test WHERE grp = 'NONE';
 ?column? 
----------
 t
(1 row)

--
-- Negative values use two's complement
--
SELECT bit_and_agg(x) FROM (SELECT -1 x FROM dual
                            UNION ALL SELECT 6 FROM dual) t;
 bit_and_agg 
-------------
           6
(1 row)

SELECT bit_and_agg(x) FROM (SELECT -8 x FROM dual
                            UNION ALL SELECT 12 FROM dual) t;
 bit_and_agg 
-------------
           8
(1 row)

--
-- Fractional values are truncated toward zero before aggregating
--
SELECT bit_and_agg(x) FROM (SELECT 4.64 x FROM dual
                            UNION ALL SELECT 4.4 FROM dual) t;
 bit_and_agg 
-------------
           4
(1 row)

SELECT bit_and_agg(x) FROM (SELECT 12.9 x FROM dual
                            UNION ALL SELECT 10.2 FROM dual) t;
 bit_and_agg 
-------------
           8
(1 row)

--
-- NUMBER columns
--
CREATE TABLE bit_and_agg_number (grp text, val number);
INSERT INTO bit_and_agg_number VALUES ('a', 12);
INSERT INTO bit_and_agg_number VALUES ('a', 10);
INSERT INTO bit_and_agg_number VALUES ('a', NULL);
INSERT INTO bit_and_agg_number VALUES ('b', 15);
SELECT grp, bit_and_agg(val) FROM bit_and_agg_number GROUP BY grp ORDER BY grp;
 grp | bit_and_agg 
-----+-------------
 a   |           8
 b   |          15
(2 rows)

--
-- DISTINCT keyword
--
SELECT bit_and_agg(DISTINCT val) FROM bit_and_agg_test WHERE grp = 'a';
 bit_and_agg 
-------------
           0
(1 row)

--
-- Values beyond the bigint domain raise an error
--
SELECT bit_and_agg(x) FROM (SELECT 99999999999999999999999 x FROM dual) t;
ERROR:  bigint out of range
DROP TABLE bit_and_agg_test;
DROP TABLE bit_and_agg_nulls;
DROP TABLE bit_and_agg_number;
--
-- Works in PG mode too
--
SET ivorysql.compatible_mode = pg;
SELECT sys.bit_and_agg(x) FROM (VALUES (12), (10)) AS t(x);
 bit_and_agg 
-------------
           8
(1 row)

RESET ivorysql.compatible_mode;
