-- DBA_OBJECTS / ALL_OBJECTS / USER_OBJECTS
SET IVORYSQL.COMPATIBLE_MODE TO ORACLE;
SET IVORYSQL.IDENTIFIER_CASE_SWITCH = INTERCHANGE;

--
-- Oracle-compatible object catalog views.  OBJECT_TYPE mapping across the
-- underlying catalogs, the DBA/ALL/USER visibility ladder, and the rule
-- that built-in scalar types are not listed.
--

CREATE TABLE OBJECTS_T (ID INT);
CREATE VIEW OBJECTS_V AS SELECT * FROM OBJECTS_T;
CREATE MATERIALIZED VIEW OBJECTS_MV AS SELECT * FROM OBJECTS_T;
CREATE SEQUENCE OBJECTS_SEQ;
CREATE INDEX OBJECTS_IDX ON OBJECTS_T (ID);
CREATE TYPE OBJECTS_TYPE AS (A INT);
CREATE FUNCTION OBJECTS_F() RETURN INT IS
BEGIN
	RETURN 1;
END;
/
CREATE OR REPLACE PROCEDURE OBJECTS_P IS
BEGIN
	NULL;
END;
/
CREATE OR REPLACE FUNCTION OBJECTS_TGF() RETURN TRIGGER IS
BEGIN
	RETURN NULL;
END;
/
CREATE TRIGGER OBJECTS_TRG BEFORE INSERT ON OBJECTS_T
FOR EACH ROW EXECUTE FUNCTION OBJECTS_TGF();
CREATE PACKAGE OBJECTS_PKG AS
	PROCEDURE PP();
END;
/
CREATE PACKAGE BODY OBJECTS_PKG AS
	PROCEDURE PP() IS
	BEGIN
		NULL;
	END;
END;
/

-- DBA_OBJECTS sees every object type, independent of privileges
SELECT OBJECT_NAME, OBJECT_TYPE
FROM DBA_OBJECTS
WHERE OBJECT_NAME LIKE 'OBJECTS\_%' ESCAPE '\'
ORDER BY OBJECT_TYPE, OBJECT_NAME;
 object_name |    object_type    
-------------+-------------------
 OBJECTS_F   | FUNCTION
 OBJECTS_IDX | INDEX
 OBJECTS_MV  | MATERIALIZED VIEW
 OBJECTS_PKG | PACKAGE
 OBJECTS_P   | PROCEDURE
 OBJECTS_SEQ | SEQUENCE
 OBJECTS_T   | TABLE
 OBJECTS_TRG | TRIGGER
 OBJECTS_V   | VIEW
(9 rows)


-- OBJECT_ID / NAMESPACE are catalog oids, STATUS is VALID, no DDL times
SELECT OBJECT_ID IS NOT NULL AS has_oid,
       NAMESPACE IS NOT NULL AS has_namespace,
       STATUS, TEMPORARY, GENERATED, SECONDARY,
       CREATED IS NULL AND LAST_DDL_TIME IS NULL AND "TIMESTAMP" IS NULL
           AS no_ddl_times
FROM DBA_OBJECTS
WHERE OBJECT_NAME = 'OBJECTS_T';
 has_oid | has_namespace | status | temporary | generated | secondary | no_ddl_times 
---------+---------------+--------+-----------+-----------+-----------+--------------
 t       | t             | VALID  | N         | N         | N         | t
(1 row)


-- ALL_OBJECTS without grants: only objects PostgreSQL makes PUBLIC-visible
-- (functions/procedures/packages/types carry default PUBLIC EXECUTE/USAGE;
-- tables and their triggers do not) -- consistent with ALL_PROCEDURES
CREATE ROLE OBJECTS_VIEWER NOLOGIN;
SET ROLE OBJECTS_VIEWER;
SELECT OBJECT_NAME, OBJECT_TYPE
FROM ALL_OBJECTS
WHERE OBJECT_NAME LIKE 'OBJECTS\_%' ESCAPE '\'
ORDER BY OBJECT_TYPE, OBJECT_NAME;
 object_name | object_type 
-------------+-------------
 OBJECTS_F   | FUNCTION
 OBJECTS_P   | PROCEDURE
(2 rows)


-- with SELECT on the table, the table (and its trigger) become visible
RESET ROLE;
GRANT SELECT ON OBJECTS_T TO OBJECTS_VIEWER;
SET ROLE OBJECTS_VIEWER;
SELECT OBJECT_NAME, OBJECT_TYPE
FROM ALL_OBJECTS
WHERE OBJECT_NAME LIKE 'OBJECTS\_%' ESCAPE '\'
ORDER BY OBJECT_TYPE, OBJECT_NAME;
 object_name | object_type 
-------------+-------------
 OBJECTS_F   | FUNCTION
 OBJECTS_P   | PROCEDURE
 OBJECTS_T   | TABLE
 OBJECTS_TRG | TRIGGER
(4 rows)


-- USER_OBJECTS under the viewer role only lists the viewer's own objects
SELECT COUNT(*) AS user_objects_of_viewer
FROM USER_OBJECTS
WHERE OBJECT_NAME LIKE 'OBJECTS\_%' ESCAPE '\';
 user_objects_of_viewer 
------------------------
                      0
(1 row)

RESET ROLE;

-- owner sees everything through ALL_/USER_
SELECT COUNT(*) AS user_objects_of_owner
FROM USER_OBJECTS
WHERE OBJECT_NAME LIKE 'OBJECTS\_%' ESCAPE '\';
 user_objects_of_owner 
-----------------------
                     9
(1 row)

SELECT COUNT(*) AS all_objects_of_owner
FROM ALL_OBJECTS
WHERE OBJECT_NAME LIKE 'OBJECTS\_%' ESCAPE '\';
 all_objects_of_owner 
----------------------
                    9
(1 row)


-- built-in scalar types of the sys namespace are not listed
SELECT COUNT(*) AS builtin_types_listed
FROM DBA_OBJECTS
WHERE OBJECT_TYPE = 'TYPE'
  AND OBJECT_NAME IN ('NUMBER', 'VARCHAR2', 'CLOB', 'BLOB', 'RAW');
 builtin_types_listed 
----------------------
                    0
(1 row)


-- a partitioned table appears once as TABLE; partition children are not
-- separate objects (Oracle does not list partitions in DBA_OBJECTS either)
CREATE TABLE OBJECTS_PT (ID INT) PARTITION BY RANGE (ID);
CREATE TABLE OBJECTS_PT_P1 PARTITION OF OBJECTS_PT FOR VALUES FROM (0) TO (100);

SELECT OBJECT_NAME, OBJECT_TYPE
FROM DBA_OBJECTS
WHERE OBJECT_NAME LIKE 'OBJECTS\_PT%' ESCAPE '\'
ORDER BY OBJECT_NAME;
 object_name | object_type 
-------------+-------------
 OBJECTS_PT  | TABLE
(1 row)


-- aggregates surface as AGGREGATE (sys.stragg ships with the extension)
SELECT COUNT(*) AS stragg_listed
FROM DBA_OBJECTS
WHERE OBJECT_NAME = 'STRAGG' AND OBJECT_TYPE = 'AGGREGATE';
 stragg_listed 
---------------
             1
(1 row)


DROP TABLE OBJECTS_PT;

DROP PACKAGE BODY OBJECTS_PKG;
DROP PACKAGE OBJECTS_PKG;
DROP TRIGGER OBJECTS_TRG ON OBJECTS_T;
DROP FUNCTION OBJECTS_TGF;
DROP PROCEDURE OBJECTS_P;
DROP FUNCTION OBJECTS_F;
DROP TYPE OBJECTS_TYPE;
DROP INDEX OBJECTS_IDX;
DROP SEQUENCE OBJECTS_SEQ;
DROP MATERIALIZED VIEW OBJECTS_MV;
DROP VIEW OBJECTS_V;
DROP TABLE OBJECTS_T;
DROP ROLE OBJECTS_VIEWER;
