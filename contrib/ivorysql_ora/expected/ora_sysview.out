SELECT PRODUCT, VERSION, STATUS FROM SYS.PRODUCT_COMPONENT_VERSION;
 product  | version | status 
----------+---------+--------
 IvorySQL | 19beta1 | Beta
(1 row)

SELECT PROPERTY_NAME, PROPERTY_VALUE
FROM SYS.DATABASE_PROPERTIES
WHERE PROPERTY_NAME IN ('DICT.BASE', 'NLS_CHARACTERSET',
                        'DEFAULT_PERMANENT_TABLESPACE', 'GLOBAL_DB_NAME')
ORDER BY PROPERTY_NAME;
        property_name         |   property_value   
------------------------------+--------------------
 DEFAULT_PERMANENT_TABLESPACE | PG_DEFAULT
 DICT.BASE                    | 2
 GLOBAL_DB_NAME               | contrib_regression
 NLS_CHARACTERSET             | UTF8
(4 rows)

-- DICTIONARY lists the dictionary views themselves
SELECT TABLE_NAME
FROM SYS.DICTIONARY
WHERE TABLE_NAME IN ('DICTIONARY', 'DICT_COLUMNS', 'USER_VIEWS')
ORDER BY TABLE_NAME;
  table_name  
--------------
 DICTIONARY
 DICT_COLUMNS
 USER_VIEWS
(3 rows)

-- DICT_COLUMNS describes those views, so DICT_COLUMNS must describe itself
SELECT COLUMN_NAME
FROM SYS.DICT_COLUMNS
WHERE TABLE_NAME = 'DICT_COLUMNS'
ORDER BY COLUMN_NAME;
 column_name 
-------------
 COLUMN_NAME
 COMMENTS
 TABLE_NAME
(3 rows)

SELECT COUNT(*) > 0 AS has_rows FROM SYS.DICTIONARY;
 has_rows 
----------
 t
(1 row)

-- The three *_CONS_COLUMNS views must describe the same constraints: one row
-- per constraint column, one name, no system columns, and no extra NOT NULL row
-- for a column a primary key already covers.
CREATE TABLE t_cons_agree (
    id INT PRIMARY KEY,
    name VARCHAR2(10) NOT NULL,
    note VARCHAR2(10)
);
SELECT (SELECT COUNT(*) FROM SYS.USER_CONS_COLUMNS
        WHERE TABLE_NAME = 'T_CONS_AGREE') = (
       SELECT COUNT(*) FROM SYS.ALL_CONS_COLUMNS
        WHERE TABLE_NAME = 'T_CONS_AGREE'
          AND OWNER = SYS.ORA_CASE_TRANS(CURRENT_USER::VARCHAR2)) AS user_matches_all;
 user_matches_all 
------------------
 t
(1 row)

SELECT (SELECT COUNT(*) FROM SYS.DBA_CONS_COLUMNS
        WHERE TABLE_NAME = 'T_CONS_AGREE') = (
       SELECT COUNT(*) FROM SYS.ALL_CONS_COLUMNS
        WHERE TABLE_NAME = 'T_CONS_AGREE') AS dba_matches_all;
 dba_matches_all 
-----------------
 t
(1 row)

SELECT COUNT(*) = 0 AS no_system_columns
FROM SYS.DBA_CONS_COLUMNS
WHERE TABLE_NAME = 'T_CONS_AGREE'
  AND COLUMN_NAME IN ('CTID', 'CMIN', 'CMAX', 'XMIN', 'XMAX', 'TABLEOID');
 no_system_columns 
-------------------
 t
(1 row)

SELECT COUNT(*) = 0 AS no_duplicate_rows
FROM (
    SELECT TABLE_NAME, COLUMN_NAME, POSITION
    FROM SYS.DBA_CONS_COLUMNS
    WHERE TABLE_NAME = 'T_CONS_AGREE'
    GROUP BY TABLE_NAME, COLUMN_NAME, POSITION
    HAVING COUNT(*) > 1
) D;
 no_duplicate_rows 
-------------------
 t
(1 row)

SELECT CONSTRAINT_NAME, COLUMN_NAME, POSITION
FROM SYS.USER_CONS_COLUMNS
WHERE TABLE_NAME = 'T_CONS_AGREE'
ORDER BY CONSTRAINT_NAME, COLUMN_NAME;
      constraint_name       | column_name | position 
----------------------------+-------------+----------
 T_CONS_AGREE_PKEY          | ID          | 1
 t_cons_agree_name_NOT_NULL | NAME        | 1
(2 rows)

DROP TABLE t_cons_agree;
-- ALL_TAB_COLUMNS must name every Oracle type the way Oracle does; the
-- character-semantics variants and the zoned timestamps used to leak the
-- internal type name (ORAVARCHARCHAR, ORATIMESTAMPLTZ) or lose the qualifier
CREATE TABLE t_all_data_types (
    a VARCHAR2(10 CHAR),
    b CHAR(5 CHAR),
    c TIMESTAMP WITH TIME ZONE,
    d TIMESTAMP WITH LOCAL TIME ZONE,
    e LONG RAW,
    f BOOLEAN,
    g NCLOB
);
SELECT COUNT(*) = 7 AS all_types_listed
FROM SYS.ALL_TAB_COLUMNS
WHERE TABLE_NAME = 'T_ALL_DATA_TYPES';
 all_types_listed 
------------------
 t
(1 row)

SELECT COUNT(*) = 7 AS data_types_match
FROM SYS.ALL_TAB_COLUMNS
WHERE TABLE_NAME = 'T_ALL_DATA_TYPES'
  AND (   (COLUMN_NAME = 'A' AND DATA_TYPE = 'VARCHAR2' AND CHAR_USED = 'C')
       OR (COLUMN_NAME = 'B' AND DATA_TYPE = 'CHAR' AND CHAR_USED = 'C')
       OR (COLUMN_NAME = 'C' AND DATA_TYPE = 'TIMESTAMP WITH TIME ZONE')
       OR (COLUMN_NAME = 'D' AND DATA_TYPE = 'TIMESTAMP WITH LOCAL TIME ZONE')
       OR (COLUMN_NAME = 'E' AND DATA_TYPE = 'LONG RAW')
       OR (COLUMN_NAME = 'F' AND DATA_TYPE = 'BOOLEAN')
       OR (COLUMN_NAME = 'G' AND DATA_TYPE = 'NCLOB'));
 data_types_match 
------------------
 t
(1 row)

DROP TABLE t_all_data_types;
-- Timestamp columns report their fractional-seconds precision in DATA_SCALE,
-- and NCLOB reports the same DATA_LENGTH as CLOB and BLOB
CREATE TABLE t_ts_meta (
    a TIMESTAMP,
    b TIMESTAMP(3),
    c TIMESTAMP(0),
    d TIMESTAMP(3) WITH TIME ZONE,
    e NCLOB
);
SELECT COUNT(*) = 5 AS five_columns
FROM SYS.ALL_TAB_COLUMNS
WHERE TABLE_NAME = 'T_TS_META';
 five_columns 
--------------
 t
(1 row)

SELECT COUNT(*) = 5 AS meta_matches
FROM SYS.ALL_TAB_COLUMNS
WHERE TABLE_NAME = 'T_TS_META'
  AND (   (COLUMN_NAME = 'A' AND DATA_SCALE = 6 AND DATA_LENGTH = 11)
       OR (COLUMN_NAME = 'B' AND DATA_SCALE = 3 AND DATA_LENGTH = 11)
       OR (COLUMN_NAME = 'C' AND DATA_SCALE = 0 AND DATA_LENGTH = 7)
       OR (COLUMN_NAME = 'D' AND DATA_SCALE = 3 AND DATA_LENGTH = 13)
       OR (COLUMN_NAME = 'E' AND DATA_LENGTH = 4000 AND DATA_SCALE IS NULL));
 meta_matches 
--------------
 t
(1 row)

DROP TABLE t_ts_meta;
-- ALL_TAB_COLUMNS must list every column once, even for a table that has
-- inheritance children: pg_stats holds two statistics rows per column there,
-- and joining both produced COLUMN_ID 1..4 for a two-column table
CREATE TABLE p_inh_probe (a INT, b TEXT);
INSERT INTO p_inh_probe VALUES (1, 'x');
CREATE TABLE c_inh_probe () INHERITS (p_inh_probe);
INSERT INTO c_inh_probe VALUES (2, 'y');
ANALYZE p_inh_probe;
SELECT COUNT(*) = 2 AS one_row_per_column
FROM SYS.ALL_TAB_COLUMNS WHERE TABLE_NAME = 'P_INH_PROBE';
 one_row_per_column 
--------------------
 t
(1 row)

SELECT COUNT(*) = COUNT(DISTINCT COLUMN_NAME) AS no_duplicates
FROM SYS.ALL_TAB_COLUMNS WHERE TABLE_NAME = 'P_INH_PROBE';
 no_duplicates 
---------------
 t
(1 row)

SELECT COLUMN_ID, COLUMN_NAME, AVG_COL_LEN IS NOT NULL AS has_stats
FROM SYS.ALL_TAB_COLUMNS WHERE TABLE_NAME = 'P_INH_PROBE' ORDER BY COLUMN_ID;
 column_id | column_name | has_stats 
-----------+-------------+-----------
         1 | A           | t
         2 | B           | t
(2 rows)

DROP TABLE c_inh_probe;
DROP TABLE p_inh_probe;
-- NUM_DISTINCT comes from the column statistics, like Oracle's, and stays NULL
-- while the column has never been analyzed
CREATE TABLE t_ndist_probe (a INT, b INT);
INSERT INTO t_ndist_probe SELECT g, 1 FROM generate_series(1, 100) g;
ANALYZE t_ndist_probe;
SELECT COUNT(*) = 2 AS both_known
FROM SYS.ALL_TAB_COLUMNS
WHERE TABLE_NAME = 'T_NDIST_PROBE' AND NUM_DISTINCT IS NOT NULL;
 both_known 
------------
 t
(1 row)

SELECT COLUMN_NAME, NUM_DISTINCT
FROM SYS.ALL_TAB_COLUMNS
WHERE TABLE_NAME = 'T_NDIST_PROBE'
ORDER BY COLUMN_ID;
 column_name | num_distinct 
-------------+--------------
 A           |          100
 B           |            1
(2 rows)

CREATE TABLE t_ndist_probe2 (a INT);
SELECT NUM_DISTINCT IS NULL AS unknown_before_analyze
FROM SYS.ALL_TAB_COLUMNS
WHERE TABLE_NAME = 'T_NDIST_PROBE2';
 unknown_before_analyze 
------------------------
 t
(1 row)

DROP TABLE t_ndist_probe;
DROP TABLE t_ndist_probe2;
