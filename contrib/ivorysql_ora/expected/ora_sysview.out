NOTICE:  table "test_all_tab_columns" does not exist, skipping
CREATE TABLE TEST_ALL_TAB_COLUMNS (
    ID INT PRIMARY KEY,
    NAME VARCHAR2(50) NOT NULL,
    AGE NUMERIC(5,2),
    CREATE_TIME DATE
);
ANALYZE TEST_ALL_TAB_COLUMNS;
SELECT 
    TABLE_NAME,
    COLUMN_NAME,
    COLUMN_ID,
    DATA_TYPE,
    DATA_TYPE_MOD,
    DATA_LENGTH,
    DATA_PRECISION,
    DATA_SCALE,
    NULLABLE,
    DATA_DEFAULT,
    NUM_DISTINCT,
    LOW_VALUE,
    HIGH_VALUE,
    DENSITY,
    NUM_NULLS,
    NUM_BUCKETS,
    SAMPLE_SIZE,
    CHARACTER_SET_NAME,
    CHAR_COL_DECL_LENGTH,
    GLOBAL_STATS,
    USER_STATS,
    AVG_COL_LEN,
    CHAR_LENGTH,
    CHAR_USED,
    V80_FMT_IMAGE,
    DATA_UPGRADED,
    HISTOGRAM,
    DEFAULT_LENGTH,
    "COLLATION",
    IDENTITY_COLUMN,
    DEFAULT_ON_NULL
FROM SYS.ALL_TAB_COLUMNS
WHERE TABLE_NAME = 'TEST_ALL_TAB_COLUMNS'
AND OWNER = SYS.ORA_CASE_TRANS(CURRENT_SCHEMA::VARCHAR2)
ORDER BY COLUMN_ID;
