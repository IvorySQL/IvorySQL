    ID INT NOT NULL,
    NAME VARCHAR2(30) NOT NULL,
    AGE INT NOT NULL,
    EMAIL VARCHAR2(50),
    CONSTRAINT PK_TEST PRIMARY KEY (ID, NAME),
    CONSTRAINT UQ_EMAIL UNIQUE (EMAIL)
);
