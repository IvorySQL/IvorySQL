-- A session-level change is visible in the session view only
SET nls_date_format = 'YYYY/MM/DD';
SELECT VALUE AS session_value FROM SYS.NLS_SESSION_PARAMETERS
WHERE PARAMETER = 'NLS_DATE_FORMAT';
 session_value 
---------------
 YYYY/MM/DD
