 -Inf
(5 rows)

select * from float_point_conditions where a is infinite;
  a   
------
 Inf
 Inf
 -Inf
(3 rows)

select * from float_point_conditions where a is not infinite;
      a       
--------------
 1.17549e-38
 -1.17549e-38
 Nan
 Nan
(4 rows)

drop table float_point_conditions;
