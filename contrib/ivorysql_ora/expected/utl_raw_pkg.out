SELECT pg_catalog.encode(sys.ora_utl_raw_translate(pg_catalog.decode('aabbcc','hex'), pg_catalog.decode('616263','hex'), pg_catalog.decode('7879','hex')), 'hex');
 encode 
--------
 aabbcc
(1 row)

SELECT pg_catalog.encode(sys.ora_utl_raw_overlay(pg_catalog.decode('ff','hex'), pg_catalog.decode('aabbcc','hex'), 2), 'hex');
 encode 
--------
