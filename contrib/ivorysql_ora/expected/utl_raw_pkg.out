(1 row)

SELECT sys.ora_utl_raw_compare(pg_catalog.decode('0102','hex'), pg_catalog.decode('01','hex'));
 ora_utl_raw_compare 
---------------------
                   2
(1 row)

SELECT sys.ora_utl_raw_compare(pg_catalog.decode('01ff','hex'), pg_catalog.decode('0102','hex'));
 ora_utl_raw_compare 
---------------------
                   2
(1 row)

SELECT sys.ora_utl_raw_compare(pg_catalog.decode('01','hex'), pg_catalog.decode('0102','hex'), pg_catalog.decode('ff','hex'));
 ora_utl_raw_compare 
---------------------
                   2
(1 row)

SELECT sys.ora_utl_raw_compare(NULL, pg_catalog.decode('01','hex')) IS NULL AS null_left;
 null_left 
-----------
