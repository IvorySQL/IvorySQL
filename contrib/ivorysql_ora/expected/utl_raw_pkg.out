-- Test the UTL_RAW package functions (direct sys-level entry points)
SET ivorysql.compatible_mode = oracle;
SELECT sys.ora_utl_raw_cast_to_varchar2(UTL_RAW.CAST_TO_RAW('hello'));
 ora_utl_raw_cast_to_varchar2 
------------------------------
 hello
(1 row)

SELECT sys.ora_utl_raw_cast_to_varchar2(NULL) IS NULL AS null_input;
 null_input 
------------
 t
(1 row)

SELECT sys.ora_utl_raw_length(UTL_RAW.CAST_TO_RAW('你好'));
 ora_utl_raw_length 
--------------------
                  6
(1 row)

SELECT sys.ora_utl_raw_length(NULL) IS NULL AS null_input;
 null_input 
------------
 t
(1 row)

SELECT sys.ora_utl_raw_substr(UTL_RAW.CAST_TO_RAW('hello'), 2);
 ora_utl_raw_substr 
--------------------
 \x656c6c6f
(1 row)

SELECT sys.ora_utl_raw_substr(UTL_RAW.CAST_TO_RAW('hello'), 2, 3);
 ora_utl_raw_substr 
--------------------
 \x656c6c
(1 row)

SELECT sys.ora_utl_raw_substr(UTL_RAW.CAST_TO_RAW('hello'), 10) IS NULL AS past_end;
ERROR:  SUBSTR: position 0 or beyond the end of r
SELECT sys.ora_utl_raw_substr(UTL_RAW.CAST_TO_RAW('hello'), 0);
ERROR:  SUBSTR: position 0 or beyond the end of r
SELECT sys.ora_utl_raw_substr(UTL_RAW.CAST_TO_RAW('hello'), 1, -1);
ERROR:  SUBSTR: length must be >= 1
SELECT sys.ora_utl_raw_concat(UTL_RAW.CAST_TO_RAW('ab'), UTL_RAW.CAST_TO_RAW('cd'));
 ora_utl_raw_concat 
--------------------
 \x61626364
(1 row)

SELECT sys.ora_utl_raw_concat(NULL, UTL_RAW.CAST_TO_RAW('cd'));
 ora_utl_raw_concat 
--------------------
 \x6364
(1 row)

SELECT sys.ora_utl_raw_concat(UTL_RAW.CAST_TO_RAW('ab'), NULL);
 ora_utl_raw_concat 
--------------------
 \x6162
(1 row)

SELECT sys.ora_utl_raw_concat(NULL, NULL) IS NULL AS both_null;
 both_null 
-----------
 f
(1 row)

SELECT sys.ora_utl_raw_copies(UTL_RAW.CAST_TO_RAW('ab'), 3);
 ora_utl_raw_copies 
--------------------
