(1 row)

SELECT sys.ora_utl_raw_reverse(NULL) IS NULL AS null_input;
 null_input 
------------
 t
(1 row)

SELECT pg_catalog.encode(sys.ora_utl_raw_bit_and(pg_catalog.decode('f0','hex'), pg_catalog.decode('0f','hex')), 'hex');
 encode 
--------
 00
(1 row)

SELECT pg_catalog.encode(sys.ora_utl_raw_bit_or(pg_catalog.decode('f0','hex'), pg_catalog.decode('0f00','hex')), 'hex');
 encode 
--------
 ff00
(1 row)

SELECT pg_catalog.encode(sys.ora_utl_raw_bit_xor(pg_catalog.decode('ff','hex'), pg_catalog.decode('0f','hex')), 'hex');
 encode 
--------
 f0
(1 row)

SELECT pg_catalog.encode(sys.ora_utl_raw_bit_complement(pg_catalog.decode('0f','hex')), 'hex');
 encode 
--------
 f0
(1 row)

SELECT sys.ora_utl_raw_compare(pg_catalog.decode('0102','hex'), pg_catalog.decode('0102','hex'));
 ora_utl_raw_compare 
---------------------
                   0
(1 row)

SELECT sys.ora_utl_raw_compare(pg_catalog.decode('01','hex'), pg_catalog.decode('0102','hex'));
 ora_utl_raw_compare 
---------------------
