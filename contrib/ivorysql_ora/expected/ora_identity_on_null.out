/*
 * GENERATED BY DEFAULT ON NULL AS IDENTITY
 *
 * In Oracle, "ON NULL" is a run-time rule: when the value supplied for the
 * column is NULL, the next value of the identity sequence is used instead.
 * It must therefore work for every form that can produce a NULL, not only
 * for a literal NULL constant.
 *
 * The error cases are kept at the top of the file so that their messages
 * stay right next to the statements that provoke them.
 */
/*
 * Control: GENERATED BY DEFAULT (without ON NULL) keeps rejecting NULL.
 */
CREATE TABLE ora_idn_bd (id int GENERATED BY DEFAULT AS IDENTITY,
						 v varchar2(10));
INSERT INTO ora_idn_bd VALUES (NULL, 'X');
ERROR:  cannot insert NULL into ( "ora_idn_bd"."id" )
DETAIL:  Column "id" is an identity column defined as GENERATED BY DEFAULT.
INSERT INTO ora_idn_bd VALUES (NULL, 'X'), (NULL, 'Y');
ERROR:  null value in column "id" of relation "ora_idn_bd" violates not-null constraint
DETAIL:  Failing row contains (null, X).
INSERT INTO ora_idn_bd VALUES (100, 'X');
INSERT INTO ora_idn_bd (v) VALUES ('Y');
SELECT * FROM ora_idn_bd ORDER BY id;
 id  | v 
-----+---
   1 | Y
 100 | X
(2 rows)

/*
 * Control: GENERATED ALWAYS keeps rejecting explicit values.
 */
CREATE TABLE ora_idn_al (id int GENERATED ALWAYS AS IDENTITY,
						 v varchar2(10));
INSERT INTO ora_idn_al VALUES (NULL, 'X');
ERROR:  cannot insert a generated always identity column "id"
DETAIL:  Column "id" is an identity column defined as GENERATED ALWAYS.
INSERT INTO ora_idn_al VALUES (5, 'X');
ERROR:  cannot insert a generated always identity column "id"
DETAIL:  Column "id" is an identity column defined as GENERATED ALWAYS.
INSERT INTO ora_idn_al (v) VALUES ('X');
SELECT * FROM ora_idn_al ORDER BY id;
 id | v 
----+---
  1 | X
(1 row)

/*
 * ON NULL: every form that produces a NULL has to generate a value.
 */
CREATE TABLE ora_idn_t (id int GENERATED BY DEFAULT ON NULL AS IDENTITY,
						v varchar2(10));
-- a literal NULL
INSERT INTO ora_idn_t VALUES (NULL, 'A');
-- several rows in one statement
INSERT INTO ora_idn_t VALUES (NULL, 'B'), (NULL, 'C');
-- a scalar subquery
INSERT INTO ora_idn_t VALUES ((SELECT NULL::int), 'D');
-- an expression that evaluates to NULL
INSERT INTO ora_idn_t VALUES (NULLIF(1, 1), 'E');
INSERT INTO ora_idn_t VALUES (CAST(NULL AS number), 'F');
-- values taken from another table, one of them NULL
CREATE TABLE ora_idn_src (x int, v varchar2(10));
INSERT INTO ora_idn_src VALUES (NULL, 'G');
INSERT INTO ora_idn_src VALUES (700, 'H');
INSERT INTO ora_idn_t SELECT x, v FROM ora_idn_src ORDER BY v;
-- an explicitly supplied value is kept, and does not advance the sequence
INSERT INTO ora_idn_t VALUES (500, 'I');
-- the sequence only advances for rows whose value really is NULL
INSERT INTO ora_idn_t VALUES (NULL, 'J');
-- an omitted column still uses the identity default
INSERT INTO ora_idn_t (v) VALUES ('K');
-- the DEFAULT keyword still works
INSERT INTO ora_idn_t VALUES (DEFAULT, 'L');
-- DEFAULT and NULL mixed in one multi-row VALUES statement
INSERT INTO ora_idn_t VALUES (DEFAULT, 'M'), (NULL, 'N');
SELECT * FROM ora_idn_t ORDER BY id;
 id  | v 
-----+---
   1 | A
   2 | B
   3 | C
   4 | D
   5 | E
   6 | F
   7 | G
   8 | J
   9 | K
  10 | L
  11 | M
  12 | N
 500 | I
 700 | H
(14 rows)

/*
 * The sequence value is assigned before BEFORE INSERT triggers run, so a
 * trigger already sees the generated value.
 */
CREATE TABLE ora_idn_log (id int, v varchar2(10));
CREATE FUNCTION ora_idn_trg() RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN
	INSERT INTO ora_idn_log VALUES (NEW.id, NEW.v);
	RETURN NEW;
END;
$$;
CREATE TRIGGER ora_idn_trg_t BEFORE INSERT ON ora_idn_t
	FOR EACH ROW EXECUTE FUNCTION ora_idn_trg();
INSERT INTO ora_idn_t VALUES (NULL, 'O');
INSERT INTO ora_idn_t VALUES (901, 'P');
DROP TRIGGER ora_idn_trg_t ON ora_idn_t;
SELECT * FROM ora_idn_log ORDER BY id;
DROP TABLE ora_idn_t;
DROP TABLE ora_idn_src;
DROP TABLE ora_idn_bd;
DROP TABLE ora_idn_al;
DROP TABLE ora_idn_log;
DROP FUNCTION ora_idn_trg();
/*
 * The same rule has to hold on every other path that feeds the INSERT target
 * list: MERGE, auto-updatable views, partitioned tables, RETURNING and the
 * OVERRIDING clauses.
 */
CREATE TABLE ora_idn_m (id int GENERATED BY DEFAULT ON NULL AS IDENTITY,
						v varchar2(10));
CREATE TABLE ora_idn_msrc (x int, v varchar2(10));
INSERT INTO ora_idn_msrc VALUES (NULL, 'a'), (NULL, 'b'), (800, 'c');
-- MERGE: a NULL source value generates a value, an explicit one is kept
MERGE INTO ora_idn_m t USING ora_idn_msrc s ON (t.v = s.v)
	WHEN NOT MATCHED THEN INSERT (id, v) VALUES (s.x, s.v);
SELECT * FROM ora_idn_m ORDER BY id;
-- an auto-updatable view forwards both NULL and DEFAULT to the base table
CREATE VIEW ora_idn_mv AS SELECT * FROM ora_idn_m;
INSERT INTO ora_idn_mv VALUES (NULL, 'd');
INSERT INTO ora_idn_mv VALUES (DEFAULT, 'e');
INSERT INTO ora_idn_mv VALUES (NULL, 'f'), (DEFAULT, 'g');
SELECT * FROM ora_idn_m ORDER BY id;
-- a partitioned table generates the value before the row is routed
CREATE TABLE ora_idn_p (id int GENERATED BY DEFAULT ON NULL AS IDENTITY,
						v varchar2(10)) PARTITION BY RANGE (id);
CREATE TABLE ora_idn_p1 PARTITION OF ora_idn_p FOR VALUES FROM (0) TO (1000);
CREATE TABLE ora_idn_p2 PARTITION OF ora_idn_p FOR VALUES FROM (1000) TO (2000);
INSERT INTO ora_idn_p VALUES (NULLIF(1, 1), 'h');
INSERT INTO ora_idn_p VALUES (NULL, 'i'), (NULL, 'j');
INSERT INTO ora_idn_p VALUES (1500, 'k');
SELECT tableoid::regclass AS part, id, v FROM ora_idn_p ORDER BY id;
-- RETURNING reports the generated value
INSERT INTO ora_idn_m VALUES (NULLIF(1, 1), 'l') RETURNING id, v;
-- neither OVERRIDING clause changes the ON NULL rule: they are accepted as
-- no-ops here, so a NULL still generates a value and an explicit value is
-- kept as is
INSERT INTO ora_idn_m OVERRIDING SYSTEM VALUE VALUES (NULLIF(1, 1), 'm');
INSERT INTO ora_idn_m OVERRIDING SYSTEM VALUE VALUES (900, 'n');
INSERT INTO ora_idn_m OVERRIDING USER VALUE VALUES (NULLIF(1, 1), 'o');
INSERT INTO ora_idn_m OVERRIDING USER VALUE VALUES (901, 'p');
SELECT * FROM ora_idn_m ORDER BY id;
DROP VIEW ora_idn_mv;
DROP TABLE ora_idn_m;
DROP TABLE ora_idn_msrc;
DROP TABLE ora_idn_p;
 id  | v 
-----+---
  13 | O
 901 | P
(2 rows)

 id  | v 
-----+---
   1 | a
   2 | b
 800 | c
(3 rows)

 id  | v 
-----+---
   1 | a
   2 | b
   3 | d
   4 | e
   5 | f
   6 | g
 800 | c
(7 rows)

