--
-- Test for GitHub Issue #1124: Variable Reset Bug in Nested Functions
--
-- Bug: When evaluating expressions like "v_sum := v_sum + nested_func()",
-- variables show original values instead of modified ones.
--
-- Test 1: Variable modification + nested function call in expression
-- This was the core bug - v_sum's modified value (109) was being lost
-- during expression evaluation, causing v_sum + get_30(10) to be 0 + 30 = 30
-- instead of 109 + 30 = 139
CREATE OR REPLACE FUNCTION test_bug1124_basic() RETURN NUMBER AS
    v_sum NUMBER := 99;
    v_result NUMBER;
    FUNCTION get_30(p_val NUMBER) RETURN NUMBER IS
    BEGIN
        RETURN p_val * 3;
    END get_30;
BEGIN
    -- Modify v_sum
    v_sum := v_sum + 10;  -- v_sum = 109
    -- Expression with nested function - this was buggy
    v_result := v_sum + get_30(10);  -- Should be 109 + 30 = 139
    RETURN v_result;
END;
/
SELECT test_bug1124_basic() AS result FROM dual;
 result 
--------
 139
(1 row)

DROP FUNCTION test_bug1124_basic;
-- Test 2: Multiple expressions to ensure consistent behavior
CREATE OR REPLACE FUNCTION test_bug1124_multiple() RETURN NUMBER AS
    v_sum NUMBER := 99;
    v_temp NUMBER;
    FUNCTION get_30(p_val NUMBER) RETURN NUMBER IS
    BEGIN
        RETURN p_val * 3;
    END get_30;
BEGIN
    v_sum := v_sum + 10;  -- v_sum = 109
    -- First expression
    v_temp := v_sum + get_30(10);  -- Should be 139
    -- Second expression (same) - should also be 139
    v_temp := v_sum + get_30(10);
    -- Third expression
    v_temp := v_sum + get_30(10);
    RETURN v_temp;
END;
/
SELECT test_bug1124_multiple() AS result FROM dual;
 result 
--------
 139
(1 row)

DROP FUNCTION test_bug1124_multiple;
-- Test 3: Nested procedure modifying parent variable + nested function in expression
CREATE OR REPLACE FUNCTION test_bug1124_proc_and_func() RETURN NUMBER AS
    v_sum NUMBER := 99;
    v_temp NUMBER;
    PROCEDURE add_val(p_val NUMBER) IS
    BEGIN
        v_sum := v_sum + p_val;
    END add_val;
    FUNCTION get_30(p_val NUMBER) RETURN NUMBER IS
    BEGIN
        RETURN p_val * 3;
    END get_30;
BEGIN
    -- Call nested procedure to modify v_sum
    add_val(10);  -- v_sum = 109
    -- Expression with nested function
    v_temp := v_sum + get_30(10);  -- Should be 109 + 30 = 139
    RETURN v_temp;
END;
/
SELECT test_bug1124_proc_and_func() AS result FROM dual;
 result 
--------
 139
(1 row)

DROP FUNCTION test_bug1124_proc_and_func;
-- Test 4: Test with integer type (not just NUMBER)
CREATE OR REPLACE FUNCTION test_bug1124_integer() RETURN integer AS
    v_sum integer := 99;
    v_result integer;
    FUNCTION get_30(p_val integer) RETURN integer IS
    BEGIN
        RETURN p_val * 3;
    END get_30;
BEGIN
    v_sum := v_sum + 10;  -- v_sum = 109
    v_result := v_sum + get_30(10);  -- Should be 109 + 30 = 139
    RETURN v_result;
END;
/
SELECT test_bug1124_integer() AS result FROM dual;
 result 
--------
    139
(1 row)

DROP FUNCTION test_bug1124_integer;
-- Test 5: Nested function on left side of expression
CREATE OR REPLACE FUNCTION test_bug1124_order() RETURN NUMBER AS
    v_sum NUMBER := 99;
    v_temp NUMBER;
    FUNCTION get_30(p_val NUMBER) RETURN NUMBER IS
    BEGIN
        RETURN p_val * 3;
    END get_30;
BEGIN
    v_sum := v_sum + 10;  -- v_sum = 109
    -- Nested function result on left side
    v_temp := get_30(10) + v_sum;  -- Should be 30 + 109 = 139
    RETURN v_temp;
END;
/
SELECT test_bug1124_order() AS result FROM dual;
 result 
--------
 139
(1 row)

DROP FUNCTION test_bug1124_order;
--
-- Test 6: get_functup_bytypenames() must not clobber outer loop counter or
-- read past proargtypes[] when replacing overloaded functions/procedures
-- referencing package %TYPE parameters (including OUT parameters).
--
CREATE OR REPLACE PACKAGE pkg_functup_ov IS
    v1 integer;
    v2 text;
    v3 numeric;
END pkg_functup_ov;
/
CREATE OR REPLACE FUNCTION fn_functup_ov(x pkg_functup_ov.v1%TYPE) RETURN integer IS
BEGIN
    RETURN x;
END;
/
CREATE OR REPLACE FUNCTION fn_functup_ov(x pkg_functup_ov.v2%TYPE) RETURN integer IS
BEGIN
    RETURN 2;
END;
/
-- Change package member types so SearchSysCache3 misses and calls get_functup_bytypenames()
CREATE OR REPLACE PACKAGE pkg_functup_ov IS
    v1 bigint;
    v2 varchar2(100);
    v3 numeric;
END pkg_functup_ov;
/
-- Adding a third overload previously hung in an infinite loop in get_functup_bytypenames()
CREATE OR REPLACE FUNCTION fn_functup_ov(x pkg_functup_ov.v3%TYPE) RETURN integer IS
BEGIN
    RETURN 3;
END;
/
-- Replacing the second overload must find and replace the existing entry in place
CREATE OR REPLACE FUNCTION fn_functup_ov(x pkg_functup_ov.v2%TYPE) RETURN integer IS
BEGIN
    RETURN 22;
END;
/
SELECT count(*) AS overload_count
FROM pg_proc
WHERE proname = 'fn_functup_ov';
 overload_count 
----------------
              3
(1 row)

SELECT fn_functup_ov('abc'::varchar2(100)) AS res_v2,
       fn_functup_ov(10::numeric) AS res_v3,
       fn_functup_ov(x => 'abc'::varchar2(100)) AS res_v2_named,
       fn_functup_ov(x => 10::numeric) AS res_v3_named
FROM dual;
 res_v2 | res_v3 | res_v2_named | res_v3_named 
--------+--------+--------------+--------------
     22 |      3 |           22 |            3
(1 row)

-- OUT parameter + package %TYPE: replacing after package type change must match
-- via proallargtypes without reading past proargtypes[]
CREATE OR REPLACE PACKAGE pkg_functup_out IS
    v1 integer;
END pkg_functup_out;
/
CREATE OR REPLACE PROCEDURE proc_functup_out(x pkg_functup_out.v1%TYPE, y OUT integer) IS
BEGIN
    y := x + 1;
END;
/
CREATE OR REPLACE PACKAGE pkg_functup_out IS
    v1 bigint;
END pkg_functup_out;
/
CREATE OR REPLACE PROCEDURE proc_functup_out(x pkg_functup_out.v1%TYPE, y OUT integer) IS
BEGIN
    y := x + 10;
END;
/
SELECT count(*) AS proc_overload_count
FROM pg_proc
WHERE proname = 'proc_functup_out';
 proc_overload_count 
---------------------
                   1
(1 row)

DO $$
DECLARE
    res integer;
BEGIN
    proc_functup_out(5, res);
    RAISE NOTICE 'proc_functup_out result = %', res;
END;
$$;
NOTICE:  proc_functup_out result = 15
DROP PROCEDURE proc_functup_out(bigint, OUT integer);
DROP FUNCTION fn_functup_ov(bigint);
DROP FUNCTION fn_functup_ov(varchar2);
DROP FUNCTION fn_functup_ov(numeric);
DROP PACKAGE pkg_functup_out;
DROP PACKAGE pkg_functup_ov;
