--
-- Test for GitHub Issue #1124: Variable Reset Bug in Nested Functions
--
-- Bug: When evaluating expressions like "v_sum := v_sum + nested_func()",
-- variables show original values instead of modified ones.
--
-- Test 1: Variable modification + nested function call in expression
-- This was the core bug - v_sum's modified value (109) was being lost
-- during expression evaluation, causing v_sum + get_30(10) to be 0 + 30 = 30
-- instead of 109 + 30 = 139
CREATE OR REPLACE FUNCTION test_bug1124_basic() RETURN NUMBER AS
    v_sum NUMBER := 99;
    v_result NUMBER;
    FUNCTION get_30(p_val NUMBER) RETURN NUMBER IS
    BEGIN
        RETURN p_val * 3;
    END get_30;
BEGIN
    -- Modify v_sum
    v_sum := v_sum + 10;  -- v_sum = 109
    -- Expression with nested function - this was buggy
    v_result := v_sum + get_30(10);  -- Should be 109 + 30 = 139
    RETURN v_result;
END;
/
SELECT test_bug1124_basic() AS result FROM dual;
 result 
--------
 139
(1 row)

DROP FUNCTION test_bug1124_basic;
-- Test 2: Multiple expressions to ensure consistent behavior
CREATE OR REPLACE FUNCTION test_bug1124_multiple() RETURN NUMBER AS
    v_sum NUMBER := 99;
    v_temp NUMBER;
    FUNCTION get_30(p_val NUMBER) RETURN NUMBER IS
    BEGIN
        RETURN p_val * 3;
    END get_30;
BEGIN
    v_sum := v_sum + 10;  -- v_sum = 109
    -- First expression
    v_temp := v_sum + get_30(10);  -- Should be 139
    -- Second expression (same) - should also be 139
    v_temp := v_sum + get_30(10);
    -- Third expression
    v_temp := v_sum + get_30(10);
    RETURN v_temp;
END;
/
SELECT test_bug1124_multiple() AS result FROM dual;
 result 
--------
 139
(1 row)

DROP FUNCTION test_bug1124_multiple;
-- Test 3: Nested procedure modifying parent variable + nested function in expression
CREATE OR REPLACE FUNCTION test_bug1124_proc_and_func() RETURN NUMBER AS
    v_sum NUMBER := 99;
    v_temp NUMBER;
    PROCEDURE add_val(p_val NUMBER) IS
    BEGIN
        v_sum := v_sum + p_val;
    END add_val;
    FUNCTION get_30(p_val NUMBER) RETURN NUMBER IS
    BEGIN
        RETURN p_val * 3;
    END get_30;
BEGIN
    -- Call nested procedure to modify v_sum
    add_val(10);  -- v_sum = 109
    -- Expression with nested function
    v_temp := v_sum + get_30(10);  -- Should be 109 + 30 = 139
    RETURN v_temp;
END;
/
SELECT test_bug1124_proc_and_func() AS result FROM dual;
 result 
--------
 139
(1 row)

DROP FUNCTION test_bug1124_proc_and_func;
-- Test 4: Test with integer type (not just NUMBER)
CREATE OR REPLACE FUNCTION test_bug1124_integer() RETURN integer AS
    v_sum integer := 99;
    v_result integer;
    FUNCTION get_30(p_val integer) RETURN integer IS
    BEGIN
        RETURN p_val * 3;
    END get_30;
BEGIN
    v_sum := v_sum + 10;  -- v_sum = 109
    v_result := v_sum + get_30(10);  -- Should be 109 + 30 = 139
    RETURN v_result;
END;
/
SELECT test_bug1124_integer() AS result FROM dual;
 result 
--------
    139
(1 row)

DROP FUNCTION test_bug1124_integer;
-- Test 5: Nested function on left side of expression
CREATE OR REPLACE FUNCTION test_bug1124_order() RETURN NUMBER AS
    v_sum NUMBER := 99;
    v_temp NUMBER;
    FUNCTION get_30(p_val NUMBER) RETURN NUMBER IS
    BEGIN
        RETURN p_val * 3;
    END get_30;
BEGIN
    v_sum := v_sum + 10;  -- v_sum = 109
    -- Nested function result on left side
    v_temp := get_30(10) + v_sum;  -- Should be 30 + 109 = 139
    RETURN v_temp;
END;
/
SELECT test_bug1124_order() AS result FROM dual;
 result 
--------
 139
(1 row)

DROP FUNCTION test_bug1124_order;
--
-- Test for GitHub Issue #3153: a block nested in IF, LOOP or an exception
-- handler, a block with no statements, or the first reference to a package
-- broke a later EXECUTE ... USING of the caller (no parameter :1).
--
-- Test 1: a block inside IF, LOOP and an exception handler
DECLARE
    v integer;
BEGIN
    IF 1 = 1 THEN
        BEGIN NULL; END;
    END IF;
    EXECUTE 'SELECT :1 + 1 FROM dual' INTO v USING 1;
    RAISE NOTICE 'after IF: %', v;
    FOR i IN 1..2 LOOP
        BEGIN NULL; END;
    END LOOP;
    EXECUTE 'SELECT :1 + 1 FROM dual' INTO v USING 2;
    RAISE NOTICE 'after LOOP: %', v;
    BEGIN
        RAISE EXCEPTION 'x';
    EXCEPTION
        WHEN OTHERS THEN
            BEGIN NULL; END;
    END;
    EXECUTE 'BEGIN RAISE NOTICE ''after handler: %'', :1; END;' USING 3;
END;
/
NOTICE:  after IF: 2
NOTICE:  after LOOP: 3
NOTICE:  after handler: 3
-- Test 2: a procedure with a block inside IF, and a procedure with no statements
CREATE OR REPLACE PROCEDURE test_bug3153_nested IS
BEGIN
    IF 1 = 1 THEN
        BEGIN NULL; END;
    END IF;
END;
/
CREATE OR REPLACE PROCEDURE test_bug3153_empty IS
BEGIN
END;
/
BEGIN
    test_bug3153_nested;
    EXECUTE 'BEGIN RAISE NOTICE ''after nested: %'', :1; END;' USING 4;
    test_bug3153_empty;
    EXECUTE 'BEGIN RAISE NOTICE ''after empty: %'', :1; END;' USING 5;
END;
/
NOTICE:  after nested: 4
NOTICE:  after empty: 5
DROP PROCEDURE test_bug3153_nested;
DROP PROCEDURE test_bug3153_empty;
--
-- The first reference to a package runs its initialization.  Each test below
-- starts a new session, so that the package is not loaded yet.
--
CREATE OR REPLACE PACKAGE test_bug3153_proc IS
    PROCEDURE p;
END;
/
CREATE OR REPLACE PACKAGE BODY test_bug3153_proc IS
    PROCEDURE p IS
    BEGIN
        RAISE NOTICE 'in p';
    END;
END;
/
CREATE OR REPLACE PACKAGE test_bug3153_var IS
    g integer := 7;
END;
/
CREATE OR REPLACE PACKAGE test_bug3153_init IS
    g integer;
    FUNCTION f(a integer) RETURN integer;
END;
/
CREATE OR REPLACE PACKAGE BODY test_bug3153_init IS
    FUNCTION f(a integer) RETURN integer IS
    BEGIN
        RETURN a + g;
    END;
BEGIN
    EXECUTE 'SELECT :1 * 2 FROM dual' INTO g USING 21;
END;
/
CREATE OR REPLACE PACKAGE test_bug3153_fail IS
    g integer;
END;
/
CREATE OR REPLACE PACKAGE BODY test_bug3153_fail IS
BEGIN
    RAISE EXCEPTION 'init failed';
END;
/
CREATE OR REPLACE FUNCTION test_bug3153_func RETURN integer IS
    v integer;
BEGIN
    v := test_bug3153_var.g;
    EXECUTE 'SELECT :1 + 1 FROM dual' INTO v USING v;
    RETURN v;
END;
/
-- Test 3: call a package procedure, then run a dynamic block with a bind
\c
BEGIN
    test_bug3153_proc.p;
    EXECUTE 'BEGIN RAISE NOTICE ''bind %'', :1; END;' USING 1;
END;
/
NOTICE:  in p
NOTICE:  bind 1
-- Test 4: a function reads a package variable, then binds it
\c
SELECT test_bug3153_func() AS result FROM dual;
 result 
--------
      8
(1 row)

-- Test 5: the initialization section itself runs dynamic SQL with a bind
\c
DECLARE
    v integer;
BEGIN
    v := test_bug3153_init.g;
    EXECUTE 'SELECT :1 + :2 FROM dual' INTO v USING v, 1;
    RAISE NOTICE 'result %', v;
END;
/
NOTICE:  result 43
-- Test 6: the same package is first referenced in dynamic SQL with a bind
\c
DECLARE
    v integer;
BEGIN
    EXECUTE 'SELECT test_bug3153_init.f(:1) FROM dual' INTO v USING 1;
    RAISE NOTICE 'result %', v;
    EXECUTE 'SELECT :1 + :2 FROM dual' INTO v USING v, 1;
    RAISE NOTICE 'result %', v;
END;
/
NOTICE:  result 43
NOTICE:  result 44
-- Test 7: the initialization section fails
\c
BEGIN
    BEGIN
        RAISE NOTICE '%', test_bug3153_fail.g;
    EXCEPTION
        WHEN OTHERS THEN
            RAISE NOTICE 'caught: %', SQLERRM;
    END;
    EXECUTE 'BEGIN RAISE NOTICE ''bind %'', :1; END;' USING 3;
END;
/
NOTICE:  caught: init failed
NOTICE:  bind 3
DROP FUNCTION test_bug3153_func;
DROP PACKAGE test_bug3153_proc;
DROP PACKAGE test_bug3153_var;
DROP PACKAGE test_bug3153_init;
DROP PACKAGE test_bug3153_fail;
