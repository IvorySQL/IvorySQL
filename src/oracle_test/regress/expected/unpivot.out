--
-- Oracle-compatible UNPIVOT tests
--
CREATE TABLE unpivot_t (
    id int,
    q1 int,
    q2 int,
    q3 int,
    memo text
);
INSERT INTO unpivot_t VALUES
    (1, 10, 20, NULL, 'row1'),
    (2, NULL, NULL, 30, 'row2'),
    (3, NULL, NULL, NULL, 'row3');
-- Default is EXCLUDE NULLS.
SELECT *
FROM unpivot_t
UNPIVOT (amount FOR quarter IN (q1, q2, q3))
ORDER BY id, quarter;
 id | memo | quarter | amount 
----+------+---------+--------
  1 | row1 | Q1      | 10
  1 | row1 | Q2      | 20
  2 | row2 | Q3      | 30
(3 rows)

-- The source is scanned once for all UNPIVOT branches.
EXPLAIN (COSTS OFF)
SELECT * FROM unpivot_t
UNPIVOT (amount FOR quarter IN (q1, q2, q3));
                        QUERY PLAN                         
-----------------------------------------------------------
 Nested Loop
   ->  Seq Scan on unpivot_t
   ->  Append
         ->  Result
               One-Time Filter: (unpivot_t.q1 IS NOT NULL)
         ->  Result
               One-Time Filter: (unpivot_t.q2 IS NOT NULL)
         ->  Result
               One-Time Filter: (unpivot_t.q3 IS NOT NULL)
(9 rows)

-- Implicit labels uppercase unquoted columns but preserve quoted identifiers.
SELECT k, v
FROM (SELECT 1 AS "mixedCase", 2 AS plain) s
UNPIVOT (v FOR k IN ("mixedCase", plain))
ORDER BY k;
     k     | v 
-----------+---
 PLAIN     | 2
 mixedCase | 1
(2 rows)

-- Explicit labels and EXCLUDE NULLS.
SELECT *
FROM unpivot_t
UNPIVOT EXCLUDE NULLS
    (amount FOR quarter IN (q1 AS 'FIRST',
                            q2 AS 'SECOND',
                            q3 AS 'THIRD'))
ORDER BY id, quarter;
 id | memo | quarter | amount 
----+------+---------+--------
  1 | row1 | FIRST   | 10
  1 | row1 | SECOND  | 20
  2 | row2 | THIRD   | 30
(3 rows)

-- INCLUDE NULLS generates rows for each input column.
SELECT *
FROM unpivot_t
UNPIVOT INCLUDE NULLS
    (amount FOR quarter IN (q1 AS 'FIRST',
                            q2 AS 'SECOND',
                            q3 AS 'THIRD'))
ORDER BY id, quarter;
 id | memo | quarter | amount 
----+------+---------+--------
  1 | row1 | FIRST   | 10
  1 | row1 | SECOND  | 20
  1 | row1 | THIRD   | 
  2 | row2 | FIRST   | 
  2 | row2 | SECOND  | 
  2 | row2 | THIRD   | 30
  3 | row3 | FIRST   | 
  3 | row3 | SECOND  | 
  3 | row3 | THIRD   | 
(9 rows)

-- A source alias belongs to the input; the post-UNPIVOT alias names output.
SELECT id, memo, quarter, amount
FROM unpivot_t s
UNPIVOT (amount FOR quarter IN (q1, q2)) u
ORDER BY id, quarter;
 id | memo | quarter | amount 
----+------+---------+--------
  1 | row1 | Q1      | 10
  1 | row1 | Q2      | 20
(2 rows)

-- UNPIVOT is not reserved and can be used as an output alias.
SELECT unpivot.id, unpivot.memo
FROM unpivot_t
UNPIVOT (amount FOR quarter IN (q1, q2)) unpivot
ORDER BY unpivot.id;
 id | memo 
----+------
  1 | row1
  1 | row1
(2 rows)

-- UNPIVOT is also available as a column name.
SELECT unpivot FROM (SELECT 1 AS unpivot) s;
 unpivot 
---------
       1
(1 row)

-- INCLUDE/EXCLUDE remain usable as ordinary target aliases.
SELECT unpivot include FROM (SELECT 1 AS unpivot) s;
 include 
---------
       1
(1 row)

SELECT unpivot exclude FROM (SELECT 1 AS unpivot) s;
 exclude 
---------
       1
(1 row)

-- UNPIVOT remains usable in other identifier positions followed by "(".
CREATE TABLE unpivot (id int);
INSERT INTO unpivot(id) VALUES (1);
SELECT * FROM unpivot;
 id 
----
  1
(1 row)

DROP TABLE unpivot;
-- Contextual keyword lookahead also works inside a function call.
CREATE FUNCTION unpivot(anyelement) RETURNS anyelement
LANGUAGE sql IMMUTABLE AS $body$SELECT $1$body$;
/
SELECT unpivot((
    SELECT v
    FROM unpivot_t
    UNPIVOT (v FOR k IN (q1, q2))
    LIMIT 1
));
 unpivot 
---------
 10
(1 row)

SELECT unpivot(unpivot(unpivot(unpivot(1))));
 unpivot 
---------
       1
(1 row)

-- Replayed probe tokens still recognize the Oracle outer-join operator.
CREATE TABLE unpivot_outer_join (value int);
INSERT INTO unpivot_outer_join VALUES (10), (20);
SELECT count(*)
FROM unpivot_t u, unpivot_outer_join o
WHERE o.value = unpivot(u.q1(+));
 count 
-------
     2
(1 row)

DROP TABLE unpivot_outer_join;
DROP FUNCTION unpivot(anyelement);
WITH unpivot(x) AS (SELECT 1)
SELECT * FROM unpivot;
 x 
---
 1
(1 row)

SELECT * FROM generate_series(1, 2) AS unpivot(x);
 x 
---
 1
 2
(2 rows)

SELECT id, k, v
FROM ONLY(unpivot_t)
UNPIVOT (v FOR k IN (q1, q2))
WHERE id = 1
ORDER BY k;
 id | k  | v  
----+----+----
  1 | Q1 | 10
  1 | Q2 | 20
(2 rows)

-- A subquery is a valid UNPIVOT source.
SELECT *
FROM (SELECT id, q1, q2, memo FROM unpivot_t) s
UNPIVOT (amount FOR quarter IN (q1 AS 'A', q2 AS 'B')) u
ORDER BY u.id, u.quarter;
 id | memo | quarter | amount 
----+------+---------+--------
  1 | row1 | A       | 10
  1 | row1 | B       | 20
(2 rows)

-- Correlated subqueries can be used inside a LATERAL UNPIVOT result.
SELECT outer_t.id, u.k, u.v
FROM unpivot_t outer_t
CROSS JOIN LATERAL (
    SELECT *
    FROM (SELECT outer_t.id AS source_id,
                 outer_t.q1 AS outer_q1,
                 outer_t.q2 AS outer_q2) s
    UNPIVOT (v FOR k IN (outer_q1, outer_q2))
) u
WHERE outer_t.id = 1
ORDER BY u.k;
 id |    k     | v  
----+----------+----
  1 | OUTER_Q1 | 10
  1 | OUTER_Q2 | 20
(2 rows)

-- A CTE is a valid UNPIVOT source.
WITH source AS MATERIALIZED (
    SELECT id, q1, q2, memo FROM unpivot_t WHERE id = 1
)
SELECT *
FROM source
UNPIVOT (amount FOR quarter IN (q1, q2))
ORDER BY quarter;
 id | memo | quarter | amount 
----+------+---------+--------
  1 | row1 | Q1      | 10
  1 | row1 | Q2      | 20
(2 rows)

-- A view is a valid UNPIVOT source.
CREATE VIEW unpivot_input_v AS
SELECT id, q1, q2, memo FROM unpivot_t;
SELECT *
FROM unpivot_input_v
UNPIVOT (amount FOR quarter IN (q1, q2))
WHERE id = 1
ORDER BY quarter;
 id | memo | quarter | amount 
----+------+---------+--------
  1 | row1 | Q1      | 10
  1 | row1 | Q2      | 20
(2 rows)

-- Repeated input columns are valid and produce repeated output rows.
SELECT id, quarter, amount
FROM unpivot_t
UNPIVOT (amount FOR quarter IN (q1, q1, q2))
WHERE id = 1
ORDER BY quarter, amount;
 id | quarter | amount 
----+---------+--------
  1 | Q1      | 10
  1 | Q1      | 10
  1 | Q2      | 20
(3 rows)

-- A direct join is a valid UNPIVOT source.
CREATE TABLE unpivot_dim (id int, note text);
INSERT INTO unpivot_dim VALUES (1, 'dim1'), (2, 'dim2');
SELECT *
FROM unpivot_t JOIN unpivot_dim USING (id)
UNPIVOT (amount FOR quarter IN (q1, q2, q3)) u
ORDER BY id, quarter;
 id | memo | note | quarter | amount 
----+------+------+---------+--------
  1 | row1 | dim1 | Q1      | 10
  1 | row1 | dim1 | Q2      | 20
  2 | row2 | dim2 | Q3      | 30
(3 rows)

-- An aliased parenthesized join is a valid UNPIVOT source.
SELECT u.id, u.note, u.quarter, u.amount
FROM (unpivot_t JOIN unpivot_dim USING (id)) j
UNPIVOT (amount FOR quarter IN (q1, q2, q3)) u
WHERE u.id = 1
ORDER BY u.quarter;
 id | note | quarter | amount 
----+------+---------+--------
  1 | dim1 | Q1      | 10
  1 | dim1 | Q2      | 20
(2 rows)

-- Multiple measures and descriptors.
CREATE TABLE unpivot_multi (
    id numeric,
    q1_qty numeric,
    q1_amt numeric,
    q2_qty numeric,
    q2_amt numeric,
    note text
);
INSERT INTO unpivot_multi VALUES
    (1, 10, 100.5, 20, NULL, 'partial'),
    (2, NULL, NULL, 30, 300, 'full2'),
    (3, NULL, NULL, NULL, NULL, 'allnull'),
    (4, 40, NULL, NULL, 400, 'partial2');
SELECT *
FROM unpivot_multi
UNPIVOT (
    (qty, amt) FOR (year, quarter) IN (
        (q1_qty, q1_amt) AS (2024, 'Q1'),
        (q2_qty, q2_amt) AS (2024, 'Q2')
    )
)
ORDER BY id, year, quarter;
 id |   note   | year | quarter | qty |  amt  
----+----------+------+---------+-----+-------
  1 | partial  | 2024 | Q1      | 10  | 100.5
  1 | partial  | 2024 | Q2      | 20  | 
  2 | full2    | 2024 | Q2      | 30  | 300
  4 | partial2 | 2024 | Q1      | 40  | 
  4 | partial2 | 2024 | Q2      |     | 400
(5 rows)

SELECT *
FROM unpivot_multi
UNPIVOT INCLUDE NULLS (
    (qty, amt) FOR (year, quarter) IN (
        (q1_qty, q1_amt) AS (2024, 'Q1'),
        (q2_qty, q2_amt) AS (2024, 'Q2')
    )
)
ORDER BY id, year, quarter;
 id |   note   | year | quarter | qty |  amt  
----+----------+------+---------+-----+-------
  1 | partial  | 2024 | Q1      | 10  | 100.5
  1 | partial  | 2024 | Q2      | 20  | 
  2 | full2    | 2024 | Q1      |     | 
  2 | full2    | 2024 | Q2      | 30  | 300
  3 | allnull  | 2024 | Q1      |     | 
  3 | allnull  | 2024 | Q2      |     | 
  4 | partial2 | 2024 | Q1      | 40  | 
  4 | partial2 | 2024 | Q2      |     | 400
(8 rows)

-- Tuple inputs without AS use a combined implicit label.
SELECT id, year, quarter
FROM unpivot_multi
UNPIVOT (
    (qty, amt) FOR (year, quarter) IN (
        (q1_qty, q1_amt),
        (q2_qty, q2_amt)
    )
)
WHERE id = 1
ORDER BY quarter;
 id |     year      |    quarter    
----+---------------+---------------
  1 | Q1_QTY_Q1_AMT | Q1_QTY_Q1_AMT
  1 | Q2_QTY_Q2_AMT | Q2_QTY_Q2_AMT
(2 rows)

-- Explicit NULL labels are valid for SELECT.
SELECT id, quarter, amount, pg_typeof(quarter)
FROM unpivot_t
UNPIVOT (amount FOR quarter IN (q1 AS NULL, q2 AS NULL))
WHERE id = 1
ORDER BY amount;
 id | quarter | amount | pg_typeof 
----+---------+--------+-----------
  1 |         | 10     | varchar2
  1 |         | 20     | varchar2
(2 rows)

-- Oracle does not permit zero-length descriptor columns in CTAS.
CREATE TABLE unpivot_null_ctas AS
SELECT id, quarter, amount
FROM unpivot_t
UNPIVOT (amount FOR quarter IN (q1 AS NULL, q2 AS NULL));
ERROR:  zero-length columns are not allowed
-- A zero-length descriptor used only for ordering is not a CTAS output column.
CREATE TABLE unpivot_resjunk_ctas AS
SELECT id, amount
FROM unpivot_t
UNPIVOT (amount FOR quarter IN (q1 AS NULL, q2 AS NULL))
ORDER BY quarter, id;
SELECT * FROM unpivot_resjunk_ctas ORDER BY id, amount;
 id | amount 
----+--------
  1 | 10
  1 | 20
(2 rows)

-- An untyped NULL label adopts the type of the other labels.
SELECT id, quarter, amount
FROM unpivot_t
UNPIVOT (amount FOR quarter IN (q1 AS NULL, q2 AS 2))
WHERE id = 1
ORDER BY amount;
 id | quarter | amount 
----+---------+--------
  1 |         | 10
  1 | 2       | 20
(2 rows)

-- Duplicate labels are valid and produce duplicate descriptor values.
SELECT id, quarter, amount
FROM unpivot_t
UNPIVOT (amount FOR quarter IN (q1 AS 'SAME', q2 AS 'SAME'))
WHERE id = 1
ORDER BY amount;
 id | quarter | amount 
----+---------+--------
  1 | SAME    | 10
  1 | SAME    | 20
(2 rows)

-- Descriptor and measure list sizes must agree with FOR and the output names.
SELECT id, v
FROM unpivot_t
UNPIVOT (v FOR (k1, k2) IN (q1 AS 'one', q2 AS 'two'));
ERROR:  UNPIVOT label list has 1 values, expected 2
LINE 3: UNPIVOT (v FOR (k1, k2) IN (q1 AS 'one', q2 AS 'two'));
                                    ^
SELECT id, v
FROM unpivot_t
UNPIVOT ((v) FOR k IN ((q1, q2)));
ERROR:  UNPIVOT IN tuple has 2 columns, expected 1
LINE 3: UNPIVOT ((v) FOR k IN ((q1, q2)));
                               ^
-- IN items must be simple unqualified column names.
SELECT id, v
FROM unpivot_t
UNPIVOT (v FOR k IN (unpivot_t.q1, unpivot_t.q2));
ERROR:  syntax error at or near "."
LINE 3: UNPIVOT (v FOR k IN (unpivot_t.q1, unpivot_t.q2));
                                      ^
-- Labels may be foldable constant expressions.
SELECT id, quarter, amount
FROM unpivot_t
UNPIVOT (
    amount FOR quarter IN (
        q1 AS UPPER('first'),
        q2 AS UPPER('second'),
        q3 AS UPPER('third')
    )
)
ORDER BY id, quarter;
 id | quarter | amount 
----+---------+--------
  1 | FIRST   | 10
  1 | SECOND  | 20
  2 | THIRD   | 30
(3 rows)

SELECT pg_typeof(quarter)
FROM unpivot_t
UNPIVOT (
    amount FOR quarter IN (
        q1 AS UPPER('first'),
        q2 AS UPPER('second'),
        q3 AS UPPER('third')
    )
)
LIMIT 1;
 pg_typeof 
-----------
 varchar2
(1 row)

SELECT id, quarter, amount
FROM unpivot_t
UNPIVOT (
    amount FOR quarter IN (
        q1 AS 1 + 1,
        q2 AS 2 + 2,
        q3 AS 3 + 3
    )
)
ORDER BY id, quarter;
 id | quarter | amount 
----+---------+--------
  1 | 2       | 10
  1 | 4       | 20
  2 | 6       | 30
(3 rows)

SELECT id, quarter, amount
FROM unpivot_t
UNPIVOT (
    amount FOR quarter IN (
        q1 AS DATE '2024-01-01',
        q2 AS DATE '2024-04-01',
        q3 AS DATE '2024-07-01'
    )
)
ORDER BY id, quarter;
 id |  quarter   | amount 
----+------------+--------
  1 | 2024-01-01 | 10
  1 | 2024-04-01 | 20
  2 | 2024-07-01 | 30
(3 rows)

-- Labels must be constant and belong to one type group.
SELECT id, amount
FROM unpivot_t
UNPIVOT (amount FOR quarter IN (q1 AS SYSDATE, q2 AS SYSDATE));
ERROR:  non-constant expression is not allowed for UNPIVOT labels
LINE 3: UNPIVOT (amount FOR quarter IN (q1 AS SYSDATE, q2 AS SYSDATE...
                                        ^
SELECT id, amount
FROM unpivot_t
UNPIVOT (amount FOR quarter IN (q1 AS q1 + 1, q2 AS q2 + 1));
ERROR:  "q1": invalid identifier
LINE 3: UNPIVOT (amount FOR quarter IN (q1 AS q1 + 1, q2 AS q2 + 1))...
                                              ^
SELECT id, amount
FROM unpivot_t
UNPIVOT (amount FOR quarter IN (q1 AS count(*), q2 AS count(*)));
ERROR:  non-constant expression is not allowed for UNPIVOT labels
LINE 3: UNPIVOT (amount FOR quarter IN (q1 AS count(*), q2 AS count(...
                                        ^
SELECT id, amount
FROM unpivot_t
UNPIVOT (
    amount FOR quarter IN (
        q1 AS generate_series(1, 2),
        q2 AS generate_series(1, 2)
    )
);
ERROR:  non-constant expression is not allowed for UNPIVOT labels
LINE 5:         q1 AS generate_series(1, 2),
                ^
SELECT id, amount
FROM unpivot_t
UNPIVOT (
    amount FOR quarter IN (
        q1 AS row_number() OVER (),
        q2 AS row_number() OVER ()
    )
);
ERROR:  non-constant expression is not allowed for UNPIVOT labels
LINE 5:         q1 AS row_number() OVER (),
                ^
SELECT id, amount
FROM unpivot_t
UNPIVOT (amount FOR quarter IN (q1 AS 'ONE', q2 AS 2));
ERROR:  UNPIVOT character and pg_catalog.int4 types cannot be matched
LINE 3: UNPIVOT (amount FOR quarter IN (q1 AS 'ONE', q2 AS 2));
        ^
-- Measure types are merged according to the Oracle type group.
CREATE TABLE unpivot_types (
    id int,
    n1 number,
    n2 number,
    f1 binary_float,
    s1 char(3),
    s2 varchar2(10),
    d1 date,
    d2 timestamp
);
INSERT INTO unpivot_types VALUES
    (1, 1, 2, 3.5, 'one', 'two', DATE '2024-01-01', TIMESTAMP '2024-01-02 03:04:05'),
    (2, 4, 5, 6.5, 'six', 'seven', DATE '2024-02-01', TIMESTAMP '2024-02-02 03:04:05');
SELECT pg_typeof(v_num), pg_typeof(v_float), pg_typeof(v_char), pg_typeof(v_date)
FROM unpivot_types
UNPIVOT (
    (v_num, v_float, v_char, v_date) FOR k IN (
        (n1, n1, s1, d1),
        (n2, f1, s2, d2)
    )
)
LIMIT 1;
 pg_typeof |  pg_typeof   | pg_typeof | pg_typeof 
-----------+--------------+-----------+-----------
 number    | binary_float | varchar2  | timestamp
(1 row)

SELECT pg_typeof(v)
FROM unpivot_types
UNPIVOT (v FOR k IN (n1, f1))
LIMIT 1;
  pg_typeof   
--------------
 binary_float
(1 row)

CREATE TABLE unpivot_time (t1 time, t2 time);
INSERT INTO unpivot_time VALUES ('10:00', '11:00');
SELECT pg_typeof(v), v, k
FROM unpivot_time
UNPIVOT (v FOR k IN (t1, t2))
ORDER BY k;
    pg_typeof    |    v     | k  
-----------------+----------+----
 pg_catalog.time | 10:00:00 | T1
 pg_catalog.time | 11:00:00 | T2
(2 rows)

CREATE TABLE unpivot_type_ctas AS
SELECT v_char, k
FROM unpivot_types
UNPIVOT (
    v_char FOR k IN (s1, s2)
);
SELECT attname, format_type(atttypid, atttypmod)
FROM pg_attribute
WHERE attrelid = 'unpivot_type_ctas'::regclass AND attnum > 0
ORDER BY attnum;
 attname | format_type  
---------+--------------
 v_char  | varchar2(10)
 k       | char(2)
(2 rows)

-- Incompatible measure types are rejected during parse analysis.
SELECT id, v
FROM unpivot_types
UNPIVOT (v FOR k IN (n1, s1));
ERROR:  UNPIVOT types number and char cannot be matched
LINE 3: UNPIVOT (v FOR k IN (n1, s1));
        ^
-- An unbounded timestamp from PostgreSQL mode keeps full precision.
SET ivorysql.compatible_mode = pg;
SET datestyle = ISO;
CREATE TABLE unpivot_pg_datetime_types (
    ts_default timestamp,
    ts_zero timestamp(0),
    d date
);
INSERT INTO unpivot_pg_datetime_types VALUES (
    TIMESTAMP '2024-01-02 03:04:05.678901',
    TIMESTAMP '2024-02-03 04:05:06.789012',
    DATE '2024-04-05'
);
SET ivorysql.compatible_mode = oracle;
CREATE TABLE unpivot_pg_timestamp_ctas AS
SELECT v
FROM unpivot_pg_datetime_types
UNPIVOT (v FOR k IN (ts_default, ts_zero));
SELECT format_type(atttypid, atttypmod)
FROM pg_attribute
WHERE attrelid = 'unpivot_pg_timestamp_ctas'::regclass AND attnum = 1;
     format_type      
----------------------
 pg_catalog.timestamp
(1 row)

SELECT v
FROM unpivot_pg_timestamp_ctas
ORDER BY v;
             v              
----------------------------
 2024-01-02 03:04:05.678901
 2024-02-03 04:05:07
(2 rows)

CREATE TABLE unpivot_pg_date_ctas AS
SELECT v
FROM unpivot_pg_datetime_types
UNPIVOT (v FOR k IN (d, ts_zero));
SELECT format_type(atttypid, atttypmod)
FROM pg_attribute
WHERE attrelid = 'unpivot_pg_date_ctas'::regclass AND attnum = 1;
       format_type       
-------------------------
 pg_catalog.timestamp(0)
(1 row)

SELECT v
FROM unpivot_pg_date_ctas
ORDER BY v;
          v          
---------------------
 2024-02-03 04:05:07
 2024-04-05 00:00:00
(2 rows)

RESET datestyle;
-- Datetime measures preserve LOCAL TIME ZONE and the largest precision.
CREATE TABLE unpivot_datetime_types (
    id int,
    tl1 timestamp with local time zone,
    tl2 timestamp with local time zone,
    ts1 timestamp(3),
    ts2 timestamp(0),
    ts_default timestamp
);
INSERT INTO unpivot_datetime_types VALUES (
    1,
    TIMESTAMP '2024-01-02 03:04:05.678901',
    TIMESTAMP '2024-02-03 04:05:06.789012',
    TIMESTAMP '2024-01-02 03:04:05.678',
    TIMESTAMP '2024-02-03 04:05:06',
    TIMESTAMP '2024-03-04 05:06:07.890123'
);
SELECT pg_typeof(v), v, k
FROM unpivot_datetime_types
UNPIVOT (v FOR k IN (tl1, tl2))
ORDER BY k;
           pg_typeof            |             v              |  k  
--------------------------------+----------------------------+-----
 timestamp with local time zone | 2024-01-02 03:04:05.678901 | TL1
 timestamp with local time zone | 2024-02-03 04:05:06.789012 | TL2
(2 rows)

CREATE TABLE unpivot_timestamp_ctas AS
SELECT v
FROM unpivot_datetime_types
UNPIVOT (v FOR k IN (ts1, ts2));
SELECT attname, format_type(atttypid, atttypmod)
FROM pg_attribute
WHERE attrelid = 'unpivot_timestamp_ctas'::regclass AND attnum > 0
ORDER BY attnum;
 attname | format_type  
---------+--------------
 v       | timestamp(3)
(1 row)

CREATE TABLE unpivot_timestamp_default_ctas AS
SELECT v
FROM unpivot_datetime_types
UNPIVOT (v FOR k IN (ts_default, ts2));
SELECT format_type(atttypid, atttypmod)
FROM pg_attribute
WHERE attrelid = 'unpivot_timestamp_default_ctas'::regclass AND attnum = 1;
 format_type  
--------------
 timestamp(6)
(1 row)

SELECT v
FROM unpivot_timestamp_default_ctas
ORDER BY v;
             v              
----------------------------
 2024-02-03 04:05:06.000000
 2024-03-04 05:06:07.890123
(2 rows)

-- LOB and bounded character values belong to different UNPIVOT type groups.
CREATE TABLE unpivot_lobs (
    id int,
    c1 clob,
    c2 clob,
    v varchar2(10)
);
INSERT INTO unpivot_lobs VALUES (1, 'one', 'two', 'three');
SELECT pg_typeof(amount), amount, k
FROM unpivot_lobs
UNPIVOT (amount FOR k IN (c1, c2))
ORDER BY k;
 pg_typeof | amount | k  
-----------+--------+----
 clob      | one    | C1
 clob      | two    | C2
(2 rows)

SELECT id, amount
FROM unpivot_lobs
UNPIVOT (amount FOR k IN (c1, v));
ERROR:  UNPIVOT character types cannot be matched
LINE 3: UNPIVOT (amount FOR k IN (c1, v));
        ^
-- NCHAR-family values are incompatible with the database character set.
CREATE TABLE unpivot_nchar_types (
    id int,
    c1 char(3),
    n1 nchar(3),
    nv1 nchar varying(10)
);
INSERT INTO unpivot_nchar_types VALUES (1, 'abc', 'xyz', 'uvw');
SELECT pg_typeof(v), pg_collation_for(v), v, k
FROM unpivot_nchar_types
UNPIVOT (v FOR k IN (n1, nv1))
ORDER BY k;
 pg_typeof | pg_collation_for |  v  |  k  
-----------+------------------+-----+-----
 varchar2  | nchar_cs         | xyz | N1 
 varchar2  | nchar_cs         | uvw | NV1
(2 rows)

-- The NCHAR marker composes with the database-default character family.
SELECT c1 = n1 AS values_differ
FROM unpivot_nchar_types;
 values_differ 
---------------
 f
(1 row)

SELECT pg_collation_for(v)
FROM (
    SELECT c1 AS v FROM unpivot_nchar_types
    UNION
    SELECT n1 FROM unpivot_nchar_types
) s
LIMIT 1;
