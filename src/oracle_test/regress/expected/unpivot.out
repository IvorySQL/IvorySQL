ALTER TABLE unpivot_nchar_types ALTER COLUMN c1 TYPE nchar(3);
SELECT attcollation::regcollation
FROM pg_attribute
WHERE attrelid = 'unpivot_nchar_types'::regclass AND attname = 'c1';
