CREATE TABLE wf_dml_test (val NUMBER);
WITH FUNCTION triple(n NUMBER) RETURN NUMBER IS
BEGIN
  RETURN n * 3;
END;
INSERT INTO wf_dml_test SELECT triple(x) FROM generate_series(1,4) AS x;
SELECT * FROM wf_dml_test ORDER BY val;
 val 
