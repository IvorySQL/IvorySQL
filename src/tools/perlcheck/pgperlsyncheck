#!/bin/sh

# script to detect compile time errors and warnings in all perl files

INCLUDES="-I src/backend/catalog"
INCLUDES="-I src/test/perl -I src/backend/utils/mb/Unicode $INCLUDES"
INCLUDES="-I src/bin/pg_rewind -I src/test/ssl/t $INCLUDES"

set -e

. src/tools/perlcheck/find_perl_files

# for zsh
setopt shwordsplit 2>/dev/null || true

# Keep the compiler status separately: grep succeeds on diagnostics and fails
# when successful syntax checks are the only output.
status=0
output=$(find_perl_files "$@" | xargs -L 1 perl $INCLUDES -cw 2>&1) || status=$?
if [ -n "$output" ]; then
	printf '%s\n' "$output" | grep -v ' syntax OK$' || true
fi
exit "$status"
